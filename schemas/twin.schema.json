{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.ai/schemas/twin.schema.json",
  "title": "Twin",
  "description": "The runtime verified twin inceived from a GenesisSeed. Fail-closed lifecycle: a Twin MUST NOT be READY without identity + policy_refs + memory_refs. It also carries the MEMBRANE it mediates \u2014 the twin bridge protecting the user's three-space system from the external one \u2014 and may not open that membrane in both directions without a full crossing of the sealed thresholds and an explicit opt-in.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "twin_id",
    "seed_id",
    "status",
    "identity",
    "memory_refs",
    "policy_refs",
    "provenance_refs",
    "capabilities",
    "governance",
    "membrane"
  ],
  "properties": {
    "twin_id": {
      "type": "string",
      "minLength": 1
    },
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "SEEDED",
        "VERIFYING",
        "READY",
        "PAUSED",
        "REVOKED",
        "ARCHIVED"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": true
    },
    "memory_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Ref"
      }
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Ref"
      }
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Ref"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "governance": {
      "$ref": "common.schema.json#/$defs/Governance"
    },
    "membrane": {
      "$ref": "common.schema.json#/$defs/Membrane"
    },
    "authoring_device": {
      "$ref": "common.schema.json#/$defs/EstimatedShortfall"
    },
    "boundary": {
      "$ref": "common.schema.json#/$defs/OctonionBoundary"
    }
  },
  "allOf": [
    {
      "$comment": "Fail-closed readiness: READY demands non-empty identity, policy_refs, and memory_refs. A twin cannot go live blind.",
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "identity",
          "policy_refs",
          "memory_refs"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "minProperties": 1
          },
          "policy_refs": {
            "type": "array",
            "minItems": 1
          },
          "memory_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "$comment": "THE THRESHOLD. Bidirectional flow is the only direction that lets the external three-space reach the protected user three-space, so it is gated twice: all 22 sealed thresholds of the topic space crossed, AND an explicit purpose-bound opt-in. 21 is short \u2014 the land was seen, not entered.",
      "if": {
        "properties": {
          "membrane": {
            "properties": {
              "flow": {
                "const": "bidirectional"
              }
            },
            "required": [
              "flow"
            ]
          }
        },
        "required": [
          "membrane"
        ]
      },
      "then": {
        "properties": {
          "membrane": {
            "properties": {
              "thresholds_crossed": {
                "minimum": 22
              },
              "consent": {
                "properties": {
                  "state": {
                    "const": "opted_in"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "thresholds_crossed",
              "consent"
            ]
          }
        }
      }
    },
    {
      "$comment": "A twin that has hit the octonion shell cannot be READY. The boundary outranks readiness.",
      "if": {
        "properties": {
          "boundary": {
            "properties": {
              "state": {
                "const": "halt"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "boundary"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "not": {
              "const": "READY"
            }
          }
        }
      }
    }
  ]
}
