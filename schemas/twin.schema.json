{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.ai/schemas/twin.schema.json",
  "title": "Twin",
  "description": "The runtime verified twin inceived from a GenesisSeed. Fail-closed lifecycle: a Twin MUST NOT be READY without identity + policy_refs + memory_refs present.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "twin_id",
    "seed_id",
    "status",
    "identity",
    "memory_refs",
    "policy_refs",
    "provenance_refs",
    "capabilities"
  ],
  "properties": {
    "twin_id": { "type": "string", "minLength": 1 },
    "seed_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["SEEDED", "VERIFYING", "READY", "PAUSED", "REVOKED", "ARCHIVED"]
    },
    "identity": {
      "type": "object",
      "additionalProperties": true
    },
    "memory_refs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Ref" }
    },
    "policy_refs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Ref" }
    },
    "provenance_refs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Ref" }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "$comment": "Fail-closed readiness: READY demands non-empty identity, policy_refs, and memory_refs. A twin cannot go live blind.",
      "if": {
        "properties": { "status": { "const": "READY" } },
        "required": ["status"]
      },
      "then": {
        "required": ["identity", "policy_refs", "memory_refs"],
        "properties": {
          "identity": { "type": "object", "minProperties": 1 },
          "policy_refs": { "type": "array", "minItems": 1 },
          "memory_refs": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
